# =============================================================================
# CassavaCare AI - .gitignore
# =============================================================================

# --- Python / virtual environment ---
venv/
.venv/
env/
ENV/

# --- Python bytecode & caches ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# --- Testing & coverage artifacts ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Runtime application artifacts ---
uploads/
*.log

# --- Environment / secrets (never commit these) ---
.env
.env.*
!.env.example

# --- Local tooling / AI assistant artifacts ---
.freebuff/

# --- Generated files ---
cassava_app_qr.png

# --- Raw source data (fully split into dataset/; committing both is bloat) ---
cassava leaf disease dataset/

# --- IDE / OS cruft ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
