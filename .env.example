# =============================================================================
# CassavaCare AI - Local Environment Configuration
# =============================================================================
# Copy this file to `.env` and adjust the values as needed.
# NEVER commit your `.env` file - it may contain secrets.
#
# The application reads these variables at startup via python-dotenv.
# Any variable not set here falls back to the safe defaults in app.py.
# =============================================================================

# Flask debug mode. Keep OFF in production!
# When ON, the Werkzeug debugger is enabled, which allows REMOTE CODE
# EXECUTION if the app is reachable from the network. Only enable this
# during local development, and only while bound to 127.0.0.1.
FLASK_DEBUG=False

# Host/interface to bind to.
#   127.0.0.1 = local machine only (safe default).
#   0.0.0.0   = all interfaces; required if phones on your Wi-Fi will
#               connect via the generated QR code (generate_qr_code.py).
FLASK_HOST=127.0.0.1

# Port to bind to.
FLASK_PORT=5000

# Minimum model confidence (0.0-1.0) required to return a definitive
# diagnosis. Below this value the app responds with an "uncertain" result
# (amber, "consult an extension officer") instead of a possibly wrong
# disease diagnosis.
CONFIDENCE_THRESHOLD=0.65
